# Gemini (https://aistudio.google.com/app/apikey). Optional: without it the
# engine returns a rules-only explanation.
GEMINI_API_KEY=
PRIMARY_GEMINI_MODEL=gemini-3.6-flash
SECONDARY_GEMINI_MODEL=gemini-3.5-flash-lite

# Path to the Tesseract binary. Leave empty to auto-detect.
TESSERACT_CMD=

# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Threat-intel providers (added in later phases; all optional).
SAFE_BROWSING_API_KEY=
VIRUSTOTAL_API_KEY=
URLHAUS_AUTH_KEY=
# Real-browser sandbox (urlscan.io). Without a key only earlier public scans are used.
URLSCAN_API_KEY=

# Optional shared secret required in the X-API-Key header.
API_ACCESS_KEY=

# Use the lighter model first (about 1s) and the stronger one as fallback.
GEMINI_FAST_FIRST=true
GEMINI_TIMEOUT_SECONDS=10

# Protection for a public deployment
RATE_LIMIT_PER_MINUTE=20
RATE_LIMIT_PER_DAY=300
TRUST_PROXY_HEADERS=false
