# Gemini (https://aistudio.google.com/app/apikey). Optional: without it the
# engine returns a rules-only explanation.
GEMINI_API_KEY=
PRIMARY_GEMINI_MODEL=gemini-3.6-flash
SECONDARY_GEMINI_MODEL=gemini-3.5-flash-lite

# Path to the Tesseract binary. Leave empty to auto-detect.
TESSERACT_CMD=

# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Threat-intel providers (added in later phases; all optional).
SAFE_BROWSING_API_KEY=
VIRUSTOTAL_API_KEY=
URLHAUS_AUTH_KEY=
# Real-browser sandbox (urlscan.io). Without a key only earlier public scans are used.
URLSCAN_API_KEY=
# Chat assistant: use a DIFFERENT Gemini key than GEMINI_API_KEY. Leave empty to switch the chat off.
GEMINI_CHAT_API_KEY=

# Telegram bot (from @BotFather). Leave the token empty to keep the bot off. Never commit the token.
TELEGRAM_BOT_TOKEN=
# The public https address of this API, for the webhook. On Render it is found automatically.
TELEGRAM_PUBLIC_URL=
# Checks one person may run (protects the shared free quotas)
TELEGRAM_CHECKS_PER_HOUR=10
TELEGRAM_CHECKS_PER_DAY=30
# Optional: comma separated Telegram user ids or usernames. Empty means everyone.
TELEGRAM_ALLOWED_USERS=
# Try Telegram's "only you can see this" group replies before falling back to a private chat.
TELEGRAM_EPHEMERAL=false

# Optional shared secret required in the X-API-Key header.
API_ACCESS_KEY=

# Use the lighter model first (about 1s) and the stronger one as fallback.
GEMINI_FAST_FIRST=true
GEMINI_TIMEOUT_SECONDS=10

# Protection for a public deployment
RATE_LIMIT_PER_MINUTE=20
RATE_LIMIT_PER_DAY=300
TRUST_PROXY_HEADERS=false
